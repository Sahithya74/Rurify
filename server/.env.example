PORT=5001
NODE_ENV=development

# Database dialect: "sqlite" for zero-setup local dev, "mysql" for production
DB_DIALECT=sqlite
DB_STORAGE=./database/dev.sqlite

# Only used when DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rurify
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173

# Demo seed accounts share this password (dev only, never use in production)
SEED_DEMO_PASSWORD=Demo@1234
